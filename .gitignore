# Public repository allowlist. Keep personal work outside the repository.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/requirements.txt
!/LICENSE
!/LICENSE.*
!/.github/
/.github/*
!/.github/skills/
/.github/skills/*
!/.github/skills/job-tracker/
/.github/skills/job-tracker/*
!/.github/skills/job-tracker/SKILL.md
!/.github/skills/resume-tailor/
/.github/skills/resume-tailor/*
!/.github/skills/resume-tailor/SKILL.md
!/.github/skills/cover-letter-generator/
/.github/skills/cover-letter-generator/*
!/.github/skills/cover-letter-generator/SKILL.md
!/.github/skills/ats-matcher/
/.github/skills/ats-matcher/*
!/.github/skills/ats-matcher/SKILL.md
!/scripts/
/scripts/*
!/scripts/resume_cloner.py
!/scripts/cover_letter_cloner.py
!/scripts/resume_workflow.py
!/scripts/cover_letter_workflow.py
!/scripts/docx_fragment_utils.py
!/scripts/pdf_utils.py
!/scripts/create_example_templates.py
!/tests/
/tests/*
!/tests/test_examples.py
!/examples/
/examples/*
!/examples/resume/
/examples/resume/*
!/examples/resume/Example_Resume_BASELINE.md
!/examples/resume/Example_Resume_TEMPLATE.docx
!/examples/cover_letter/
/examples/cover_letter/*
!/examples/cover_letter/Example_CoverLetter_BASELINE.md
!/examples/cover_letter/Example_CoverLetter_TEMPLATE.docx
!/examples/company/
/examples/company/*
!/examples/company/jobs.example.json

# These are not safeguards for files already tracked, or git add --force.
__pycache__/
*.py[cod]
.venv/
.env
.env.*
~$*
